{{!
    @template mod_videopractice/index
}}
<div class="videopractice-index">
    <h2>{{#str}} modulenameplural, videopractice {{/str}}</h2>
    {{#hasitems}}
        <div class="list-group">
            {{#items}}
                <a class="list-group-item list-group-item-action" href="{{{url}}}">
                    <strong>{{name}}</strong>
                    <span class="d-block text-muted small">{{section}}</span>
                </a>
            {{/items}}
        </div>
    {{/hasitems}}
    {{^hasitems}}
        <div class="alert alert-info">{{#str}} noactivities, videopractice {{/str}}</div>{{/hasitems}}
</div>
