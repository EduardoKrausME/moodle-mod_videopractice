{{!
    @template mod_videopractice/grading_header
}}
<div class="videopractice-grading mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div><h2 class="mb-1">{{#str}} assesspractice, videopractice {{/str}}</h2>
            <div>{{student}} · {{#str}} attempt, videopractice {{/str}} {{attemptnumber}}</div>
        </div>
        <a class="btn btn-outline-warning" href="{{{returnurl}}}">{{#str}} returnforediting, videopractice {{/str}}</a>
    </div>
    {{#hasvideo}}
        <video class="videopractice-submission__video" controls preload="metadata"
               src="{{{video}}}"></video>{{/hasvideo}}
</div>
