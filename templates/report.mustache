{{!
    @template mod_videopractice/report
}}
<div class="videopractice-report">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div><h2 class="mb-1">{{#str}} report, videopractice {{/str}}</h2>
            <div class="text-muted">{{name}}</div>
        </div>
        <div class="d-flex gap-2">
            {{#canexport}}<a class="btn btn-outline-primary" href="{{{exporturl}}}">{{#str}}
                exportcsv, videopractice {{/str}}</a>{{/canexport}}
            <a class="btn btn-outline-secondary" href="{{{backurl}}}">{{#str}}
                backtoactivity, videopractice {{/str}}</a>
        </div>
    </div>
    {{#hasrows}}
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                <tr>
                    <th>{{#str}} student, videopractice {{/str}}</th>
                    <th>{{#str}} referencewatched, videopractice {{/str}}</th>
                    <th>{{#str}} submissionstatus, videopractice {{/str}}</th>
                    <th>{{#str}} assessmentstatus, videopractice {{/str}}</th>
                    <th>{{#str}} grade, videopractice {{/str}}</th>
                    <th>{{#str}} lastupdate, videopractice {{/str}}</th>
                    <th>{{#str}} actions, videopractice {{/str}}</th>
                </tr>
                </thead>
                <tbody>
                {{#rows}}
                    <tr>
                        <td><a href="{{{profileurl}}}">{{fullname}}</a><br><small class="text-muted">{{email}}</small>
                        </td>
                        <td><span
                                class="{{#referencecomplete}}text-success fw-bold{{/referencecomplete}}">{{referencepercent}}
                            %</span></td>
                        <td>{{submissionstatus}}</td>
                        <td>{{assessmentstatus}}</td>
                        <td>{{grade}}</td>
                        <td>{{lastupdate}}</td>
                        <td>{{#canassess}}<a class="btn btn-sm btn-primary" href="{{{gradeurl}}}">{{#str}}
                            vieworassess, videopractice {{/str}}</a>{{/canassess}}</td>
                    </tr>
                {{/rows}}
                </tbody>
            </table>
        </div>
    {{/hasrows}}
    {{^hasrows}}
        <div class="alert alert-info">{{#str}} statusnotstarted, videopractice {{/str}}</div>{{/hasrows}}
</div>
