{{!
    @template mod_videopractice/player
}}
<div class="videopractice-player" data-region="reference-player">
    {{#player.html5}}
        <video class="videopractice-player__video" data-region="html5-player" controls preload="metadata">
            <source src="{{{player.url}}}">
            {{#str}} browservideonotsupported, videopractice {{/str}}
        </video>
    {{/player.html5}}
    {{#player.youtube}}
        <div class="videopractice-player__embed-wrap">
            <iframe id="videopractice-youtube-player" class="videopractice-player__embed" data-region="youtube-player"
                    src="{{{player.youtubeurl}}}" title="{{#str}} referencevideotitle, videopractice {{/str}}"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen></iframe>
        </div>
    {{/player.youtube}}
    {{#player.vimeo}}
        <div class="videopractice-player__embed-wrap">
            <iframe id="videopractice-vimeo-player" class="videopractice-player__embed" data-region="vimeo-player"
                    src="{{{player.vimeourl}}}" title="{{#str}} referencevideotitle, videopractice {{/str}}"
                    allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
        </div>
    {{/player.vimeo}}
</div>
